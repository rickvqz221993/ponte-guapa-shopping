# Copy to .env and fill in. Never commit .env.
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
BASE_URL=https://tu-dominio.com

# Stripe (optional — card payments disabled until set)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# SMTP (optional — without these, emails are logged to data/email-fallback.log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ponte Guapa <hola@tu-dominio.com>
