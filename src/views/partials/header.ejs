<%
/* ---- safe locals ---- */
var _L = (typeof lang !== 'undefined' && lang) ? lang : 'es';
var _U = (typeof user !== 'undefined') ? user : null;
var _CC = (typeof cartCount !== 'undefined' && cartCount) ? cartCount : 0;
var _CSRF = (typeof csrfToken !== 'undefined') ? csrfToken : '';
var _WA = (typeof waNumber !== 'undefined' && waNumber) ? String(waNumber).replace(/\D/g,'') : '971526864330';
var _T = (typeof t !== 'undefined') ? t : function(k){ return k; };
var _pageTitle = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : '';
var _activeNav = (typeof activeNav !== 'undefined' && activeNav) ? activeNav : '';
var _waText = _T('misc.whatsapp_float');
-%>
<!DOCTYPE html>
<html lang="<%= _L %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#ff5fa2">
<meta name="description" content="<%= _T('brand.tagline') %>">
<title><%= _pageTitle ? _pageTitle + ' ♥ ' : '' %>Ponte Guapa Shopping</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/icons/icon-192.png">
<link rel="icon" type="image/png" href="/icons/icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
</head>
<body>

<!-- ===== SVG icon sprite ===== -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-home" viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h5v-6h4v6h5V9.5"/></symbol>
    <symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
    <symbol id="i-bag" viewBox="0 0 24 24"><path d="M6 8h12l-1.2 12.5a1 1 0 0 1-1 .5H8.2a1 1 0 0 1-1-.5L6 8z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-3.5 4.5-5 8-5s6.5 1.5 8 5"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></symbol>
    <symbol id="i-heart" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
    <symbol id="i-x" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="i-trash" viewBox="0 0 24 24"><path d="M4 7h16"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13"/></symbol>
    <symbol id="i-box" viewBox="0 0 24 24"><path d="M3 8l9-5 9 5v8l-9 5-9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></symbol>
    <symbol id="i-truck" viewBox="0 0 24 24"><path d="M2 6h12v10H2z"/><path d="M14 10h4l4 4v2h-8"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="m4 12.5 5 5L20 6.5"/></symbol>
    <symbol id="i-bell" viewBox="0 0 24 24"><path d="M6 9a6 6 0 0 1 12 0c0 5 2 6 2 6H4s2-1 2-6"/><path d="M10 20a2 2 0 0 0 4 0"/></symbol>
    <symbol id="i-gear" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1"/></symbol>
    <symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></symbol>
    <symbol id="i-chart" viewBox="0 0 24 24"><path d="M6 20v-7M12 20V5M18 20v-11"/><path d="M3 20h18"/></symbol>
    <symbol id="i-back" viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></symbol>
    <symbol id="i-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></symbol>
    <symbol id="i-tag" viewBox="0 0 24 24"><path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9-9-9z"/><circle cx="8" cy="8" r="1.4"/></symbol>
    <symbol id="i-send" viewBox="0 0 24 24"><path d="M21 3 10 14"/><path d="M21 3 14 21l-4-7-7-4 18-7z"/></symbol>
    <symbol id="i-edit" viewBox="0 0 24 24"><path d="M4 20h4L20 8l-4-4L4 16v4z"/><path d="m13.5 6.5 4 4"/></symbol>
    <symbol id="i-cam" viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="2"/><circle cx="12" cy="13" r="3.5"/><path d="M8 7l1.5-2.5h5L16 7"/></symbol>
    <symbol id="i-star" viewBox="0 0 24 24"><path d="m12 3 2.7 5.6 6.1.8-4.5 4.2 1.1 6-5.4-3-5.4 3 1.1-6L3.2 9.4l6.1-.8L12 3z"/></symbol>
    <symbol id="i-logout" viewBox="0 0 24 24"><path d="M9 21H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h4"/><path d="m15 7 5 5-5 5"/><path d="M20 12H9"/></symbol>
    <symbol id="i-doc" viewBox="0 0 24 24"><path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 3v4h4"/><path d="M9 13h6M9 17h6"/></symbol>
    <symbol id="i-phone" viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></symbol>
  </defs>
</svg>

<header class="site-header">
  <div class="topbar">
    <a class="brand" href="/" aria-label="Ponte Guapa Shopping">
      <span class="brand-heart">♥</span>
      <span class="brand-name">Ponte Guapa<small><%= _T('brand.tagline') %></small></span>
    </a>
    <div class="top-actions">
      <nav class="lang-switch" aria-label="<%= _T('misc.lang_label') %>">
        <a href="/lang/es" class="<%= _L === 'es' ? 'on' : '' %>"><%= _T('misc.es') %></a>
        <a href="/lang/en" class="<%= _L === 'en' ? 'on' : '' %>"><%= _T('misc.en') %></a>
      </nav>
      <% if (_U) { %>
        <% if (_U.role === 'admin') { %>
          <a class="icon-btn" href="/admin" title="<%= _T('nav.admin') %>" aria-label="<%= _T('nav.admin') %>"><svg class="ic"><use href="#i-gear"/></svg></a>
        <% } else { %>
          <a class="icon-btn" href="/mi-cuenta" title="<%= _T('nav.my_account') %>" aria-label="<%= _T('nav.my_account') %>"><svg class="ic"><use href="#i-user"/></svg></a>
        <% } %>
      <% } else { %>
        <a class="icon-btn" href="/login" title="<%= _T('nav.login') %>" aria-label="<%= _T('nav.login') %>"><svg class="ic"><use href="#i-user"/></svg></a>
      <% } %>
      <a class="icon-btn" href="/carrito" title="<%= _T('nav.cart') %>" aria-label="<%= _T('nav.cart') %>">
        <svg class="ic"><use href="#i-bag"/></svg>
        <% if (_CC > 0) { %><span class="cart-badge"><%= _CC %></span><% } %>
      </a>
      <button class="icon-btn hamburger" id="hamburger" aria-expanded="false" aria-controls="mobile-panel" aria-label="Menu"><svg class="ic"><use href="#i-menu"/></svg></button>
    </div>
  </div>
  <nav class="navrow" aria-label="Principal">
    <div class="wrap">
      <a class="nav-link <%= _activeNav === 'home' ? 'on' : '' %>" href="/"><%= _T('nav.home') %></a>
      <a class="nav-link <%= _activeNav === 'catalog' ? 'on' : '' %>" href="/catalogo"><%= _T('nav.catalog') %></a>
      <a class="nav-link <%= _activeNav === 'how' ? 'on' : '' %>" href="/como-comprar"><%= _T('nav.how_to_buy') %></a>
      <a class="nav-link <%= _activeNav === 'shipping' ? 'on' : '' %>" href="/politica-envio"><%= _T('nav.shipping_policy') %></a>
      <a class="nav-link <%= _activeNav === 'announce' ? 'on' : '' %>" href="/avisos"><%= _T('nav.announcements') %></a>
      <% if (_U) { %>
        <a class="nav-link <%= _activeNav === 'orders' ? 'on' : '' %>" href="/mis-pedidos"><%= _T('nav.my_orders') %></a>
      <% } else { %>
        <a class="nav-link" href="/login"><%= _T('nav.login') %></a>
        <a class="nav-link" href="/registro"><%= _T('nav.register') %></a>
      <% } %>
    </div>
  </nav>
  <nav class="mobile-panel" id="mobile-panel" aria-label="Menu">
    <a href="/"><%= _T('nav.home') %></a>
    <a href="/catalogo"><%= _T('nav.catalog') %></a>
    <a href="/como-comprar"><%= _T('nav.how_to_buy') %></a>
    <a href="/politica-envio"><%= _T('nav.shipping_policy') %></a>
    <a href="/avisos"><%= _T('nav.announcements') %></a>
    <% if (_U) { %>
      <a href="/mi-cuenta"><%= _T('nav.my_account') %></a>
      <a href="/mis-pedidos"><%= _T('nav.my_orders') %></a>
      <% if (_U.role === 'admin') { %><a href="/admin"><%= _T('nav.admin') %></a><% } %>
      <form method="POST" action="/logout" style="margin:0"><input type="hidden" name="_csrf" value="<%= _CSRF %>"><button type="submit" style="display:block;width:100%;text-align:left;background:none;border:0;color:#fff;font-family:inherit;font-weight:700;font-size:1rem;padding:12px 20px;cursor:pointer"><%= _T('nav.logout') %></button></form>
    <% } else { %>
      <a href="/login"><%= _T('nav.login') %></a>
      <a href="/registro"><%= _T('nav.register') %></a>
    <% } %>
  </nav>
</header>

<nav class="bottomnav" aria-label="Navegación">
  <a href="/" class="<%= _activeNav === 'home' ? 'on' : '' %>"><svg class="ic"><use href="#i-home"/></svg><%= _T('nav.home') %></a>
  <a href="/catalogo" class="<%= _activeNav === 'catalog' ? 'on' : '' %>"><svg class="ic"><use href="#i-grid"/></svg><%= _T('nav.catalog') %></a>
  <a href="/carrito" class="<%= _activeNav === 'cart' ? 'on' : '' %>"><svg class="ic"><use href="#i-bag"/></svg><%= _T('nav.cart') %><% if (_CC > 0) { %><span class="cart-badge"><%= _CC %></span><% } %></a>
  <a href="<%= _U ? '/mi-cuenta' : '/login' %>" class="<%= _activeNav === 'account' ? 'on' : '' %>"><svg class="ic"><use href="#i-user"/></svg><%= _U ? _T('nav.my_account') : _T('nav.login') %></a>
  <a href="https://wa.me/<%= _WA %>?text=<%= encodeURIComponent(_waText) %>"><svg class="ic"><use href="#i-phone"/></svg>WhatsApp</a>
</nav>

<main id="main"><div class="wrap">
